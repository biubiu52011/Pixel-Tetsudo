// == Pixel Tetsudo - Key Manager ==
// 从加密文件加载 ODPT API keys
(function() {
    'use strict';
    
    var KEY_FILE = '../data/api-keys.enc';
    var keys = {};
    var loaded = false;
    
    function decodeKeys(encoded) {
        try {
            var decoded = atob(encoded);
            var pairs = decoded.split('|');
            pairs.forEach(function(pair) {
                var idx = pair.indexOf(':');
                if (idx > 0) {
                    var name = pair.substring(0, idx).trim();
                    var value = pair.substring(idx + 1).trim();
                    keys[name] = value;
                }
            });
            loaded = true;
            console.log('[KeyManager] Keys loaded:', Object.keys(keys).length);
        } catch (e) {
            console.error('[KeyManager] Failed to decode keys:', e);
        }
    }
    
    async function loadKeys() {
        if (loaded) return;
        try {
            var resp = await fetch(KEY_FILE);
            var text = await resp.text();
            decodeKeys(text.trim());
        } catch (e) {
            console.warn('[KeyManager] Failed to load keys from file, using localStorage:', e.message);
            var stored = localStorage.getItem('odpt_keys_b64');
            if (stored) decodeKeys(stored);
        }
    }
    
    window.KeyManager = {
        getKey: function(name) {
            return keys[name] || '';
        },
        getCenterKey: function() {
            return keys['ODPT_CENTER'] || '';
        },
        getChallengeKey: function() {
            return keys['CHALLENGE_2026'] || '';
        },
        isLoaded: function() {
            return loaded;
        },
        load: loadKeys
    };
    
    // Auto-load on init
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', loadKeys);
    } else {
        loadKeys();
    }
})();
